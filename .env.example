# Rename this file to .env and add your API keys.

# ── Required ──────────────────────────────────────────────────────────────────
# Free key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── Optional: third-party data ────────────────────────────────────────────────
# Free key from https://polygon.io/dashboard/signup
# Used for company name search (US markets). Falls back to yfinance search.
POLYGON_API_KEY=your_polygon_api_key_here

# ── Optional: LLM settings ────────────────────────────────────────────────────
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_TEMP_REASON=0.1
# LLM_TEMP_STRUCT=0.0

# ── Optional: token limits per use-case ───────────────────────────────────────
# TOKENS_AGENT=4096
# TOKENS_CLASSIFY=256
# TOKENS_SENTIMENT=1024
# TOKENS_NEWS=1200
# TOKENS_PROFILE=1600
# TOKENS_SEARCH=512
# TOKENS_SECTOR=32
# TOKENS_DIAGNOSE=200

# ── Optional: rate limiting ───────────────────────────────────────────────────
# Groq free tier: 30 req/min. Paid tiers can be higher.
# GROQ_RPM=30

# ── Optional: circuit-breaker defaults ───────────────────────────────────────
# CB_FAILURE_THRESHOLD=3
# CB_RECOVERY_TIMEOUT=60
# CB_RECOVERY_POLYGON=120
# CB_RECOVERY_PRICE=90

# ── Optional: market defaults ────────────────────────────────────────────────
# Default benchmark index when no exchange-specific index is found.
# Change to ^NSEI for India-first deployments, ^FTSE for UK, etc.
# DEFAULT_BENCHMARK=^GSPC
# DEFAULT_BENCHMARK_NAME=S&P 500

# ── Optional: news RSS feeds ─────────────────────────────────────────────────
# YAHOO_RSS_URL=https://feeds.finance.yahoo.com/rss/2.0/headline
# GOOGLE_NEWS_URL=https://news.google.com/rss/search
# RSS_TIMEOUT=8

# ── Optional: external access kill-switches ──────────────────────────────────
# Set any of these to "false" to block that category of outbound calls.
# GATEWAY_LLM_ENABLED=true
# GATEWAY_MARKET_DATA_ENABLED=true
# GATEWAY_POLYGON_ENABLED=true
# GATEWAY_NEWS_RSS_ENABLED=true
