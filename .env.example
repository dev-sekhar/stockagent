# Rename this file to .env and add your API keys.

# Required — free key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional but recommended — free key from https://polygon.io/dashboard/signup
# Used for company name search (US markets). Groq web search is used as fallback.
POLYGON_API_KEY=your_polygon_api_key_here
